{
  "name": "kikoe-website",
  "private": true,
  "version": "0.1.0",
  "description": "The Kikoe website: one page, statically exported.",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npx serve out",
    "images": "node scripts/images.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "readme-images": "node scripts/readme-images.mjs",
    "test": "vitest run",
    "lint": "biome check ."
  },
  "dependencies": {
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.20.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "sharp": "0.35.4",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "packageManager": "pnpm@10.10.0",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/builtbywally/kikoe-website.git"
  }
}
